  "prefer_related_applications": false,
  "related_applications": [],
  
  "shortcuts": [
    {
      "name": "لوحة التحكم",
      "short_name": "Dashboard",
      "description": "الوصول السريع للوحة التحكم",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/assets/images/shortcut-dashboard.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "المشاريع",
      "short_name": "Projects",
      "description": "إدارة المشاريع",
      "url": "/projects",
      "icons": [
        {
          "src": "/assets/images/shortcut-projects.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "الذكاء الاصطناعي",
      "short_name": "AI",
      "description": "خدمات الذكاء الاصطناعي",
      "url": "/ai",
      "icons": [
        {
          "src": "/assets/images/shortcut-ai.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+autosmart",
      "url": "/handle?type=%s"
    }
  ],
  
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "scope_extensions": [
    {
      "origin": "https://api.autosmart.com"
    }
  ],
  
  "file_handlers": [
    {
      "action": "/handle-file",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}